<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:TeamsSync.Presentation.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>
    <!-- AccentFillColorDefault/Secondary/Tertiaryは、通常はApplicationAccentColorManagerが
         実行時にOSのアクセント色から生成するリソースで、wpf-uiのテーマXAML側には静的な
         フォールバックが無い。ライトテーマ固定のため上記マネージャーを呼ばない方針にした結果、
         これらが未定義(=透明)のままになり、ラジオボタンのホバー時などにチェックマークが
         消えて見えていた。SystemAccentColorPrimary(#0067C0、Accent.xamlの既定値)を基準に、
         wpf-ui本来の計算式(80%/90%不透明度)と同じ値を静的に定義して補う。 -->
    <Color x:Key="AccentFillColorDefault">#FF0067C0</Color>
    <Color x:Key="AccentFillColorSecondary">#E50067C0</Color>
    <Color x:Key="AccentFillColorTertiary">#CC0067C0</Color>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:HeightMinusOffsetConverter x:Key="HeightMinusOffsetConverter" />
    <GridLength x:Key="SectionLabelColumnWidth">Auto</GridLength>
    <!-- SyncModeSelectorViewの各RadioButton内アイコンで共通のDisabled表現(トリガー部分)だけを切り出す。
         平常時のForegroundは意味ごとに異なる(成功/注意/危険)ため、利用側でBasedOnして上書きする。 -->
    <Style x:Key="RadioButtonSymbolIconStyle" TargetType="ui:SymbolIcon">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                         Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StableCellFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            BorderThickness="2" CornerRadius="2" Margin="1"
                            IsHitTestVisible="False">
                        <AdornedElementPlaceholder />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- wpf-uiのDefaultTextBoxScrollViewerStyleはスクロールバー要素自体を含まず、
         複数行TextBoxで縦スクロールバーが表示されないため、標準のScrollBar付きテンプレートで上書きする -->
    <Style x:Key="DefaultTextBoxScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                            CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1"
                            Value="{TemplateBinding VerticalOffset}"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
