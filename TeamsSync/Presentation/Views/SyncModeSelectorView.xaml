<UserControl x:Class="TeamsSync.Presentation.Views.SyncModeSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:TeamsSync.Presentation.Views"
             AutomationProperties.Name="同期モード">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SectionLabelColumnWidth}" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:StepHeaderView IconSymbol="ArrowSync24" HeaderText="3  同期モード"
                               SubtitleText="入力リストを追加・指定削除・完全同期のどれに使うか選択します" />
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <RadioButton IsChecked="{Binding IsAddOnlySelected, Mode=TwoWay}"
                         GroupName="SyncMode" AutomationProperties.Name="追加のみ（既存メンバーを維持）"
                         ToolTip="リストにいる人を追加します。今のメンバーは削除されません。"
                         VerticalAlignment="Center" Margin="0,0,24,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonAdd24" FontSize="14" Margin="0,0,4,0"
                                   AutomationProperties.Name="">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource RadioButtonSymbolIconStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="追加のみ（既存メンバーを維持）" />
                </StackPanel>
            </RadioButton>
            <RadioButton IsChecked="{Binding IsRemoveSpecifiedSelected, Mode=TwoWay}"
                         GroupName="SyncMode" AutomationProperties.Name="指定メンバーを削除"
                         ToolTip="入力リストで指定した一般メンバーだけを削除します。入力していないメンバーと所有者は削除されません。"
                         VerticalAlignment="Center" Margin="0,0,24,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonDelete24" FontSize="14" Margin="0,0,4,0"
                                   AutomationProperties.Name="">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource RadioButtonSymbolIconStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="指定メンバーを削除" />
                </StackPanel>
            </RadioButton>
            <RadioButton IsChecked="{Binding IsFullSyncSelected, Mode=TwoWay}"
                         GroupName="SyncMode" AutomationProperties.Name="完全同期（リスト外を削除）"
                         ToolTip="リストにいる人を追加し、リストにない一般メンバーを削除します。チームの所有者は削除されません。"
                         VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,4,0"
                                   AutomationProperties.Name="">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource RadioButtonSymbolIconStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="完全同期（リスト外を削除）" />
                </StackPanel>
            </RadioButton>
        </WrapPanel>
    </Grid>
</UserControl>