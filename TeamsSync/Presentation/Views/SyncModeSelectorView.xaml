<UserControl x:Class="TeamsSync.Presentation.Views.SyncModeSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="同期モード">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="3  同期モード" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="リストにないメンバーの扱いを選択します" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="追加のみ（既存メンバーを維持）"
                             IsChecked="{Binding IsAddOnlySelected, Mode=TwoWay}"
                             GroupName="SyncMode" AutomationProperties.Name="追加のみ（既存メンバーを維持）"
                             VerticalAlignment="Center" Margin="0,0,24,0" />
                <RadioButton IsChecked="{Binding IsFullSyncSelected, Mode=TwoWay}"
                             GroupName="SyncMode" AutomationProperties.Name="完全同期（リスト外を削除）"
                             VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,4,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="完全同期（リスト外を削除）" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>
        <!-- 「追加のみ」と「完全同期」の違いは選択によって表示・非表示にせず、常時表示して
             どちらを選んでも起きることが選択前に分かるようにする。 -->
        <StackPanel Grid.Row="1" Margin="192,8,0,0">
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="追加のみ:" FontWeight="SemiBold" /><Run Text=" リストにいる人を追加します。今のメンバーは削除されません。" />
            </TextBlock>
            <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="完全同期:" FontWeight="SemiBold" />
                <Run Text=" リストにいる人を追加し、リストにない一般メンバーを削除します。チームの所有者は削除されません。" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
