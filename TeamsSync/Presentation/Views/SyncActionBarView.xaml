<UserControl x:Class="TeamsSync.Presentation.Views.SyncActionBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SyncWorkspace.Execution.IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar AutomationProperties.Name="同期進捗" Minimum="0"
                             Maximum="{Binding SyncWorkspace.Execution.ProgressMaximum}"
                             Value="{Binding SyncWorkspace.Execution.ProgressValue}" Height="6" />
                <TextBlock Text="{Binding SyncWorkspace.Execution.ProgressText}" Margin="0,4,0,0" FontSize="12"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="_キャンセル" Command="{Binding SyncWorkspace.CancelCommand}"
                       Margin="12,0,0,0"
                       Appearance="Secondary" ToolTip="同期をキャンセル (Esc)"
                       AutomationProperties.Name="同期処理をキャンセル" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,8,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding IsStatusError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,12,0"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="チームに_反映" Command="{Binding SyncWorkspace.ExecuteSyncCommand}"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                           Appearance="Primary" Margin="4,0"
                           ToolTip="{Binding SyncWorkspace.SyncUnavailableReason}"
                           ToolTipService.ShowOnDisabled="True"
                           AutomationProperties.Name="確認した差分をチームに反映" />
            </StackPanel>
        </Grid>

        <!-- Snackbar(一時通知)は自動で消えるため、成功・失敗・中止・処理済み件数・未反映件数はここに残す。
             読み上げは上のStatusTextで既に一度案内済みのため、ここはLiveSettingを付けず閲覧用の情報とする。 -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding SyncWorkspace.Result.HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="同期実行結果">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Symbol="CheckmarkCircle24">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SyncWorkspace.Result.HasFailedResults}" Value="True">
                                        <Setter Property="Symbol" Value="Warning24" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SyncWorkspace.Result.Cancelled}" Value="True">
                                        <Setter Property="Symbol" Value="Warning24" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="{Binding SyncWorkspace.Result.SummaryText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SyncWorkspace.Result.RemainingText}" FontSize="12" Margin="22,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding SyncWorkspace.Result.HasRemainingCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="22,4,0,0" FontSize="12"
                           Visibility="{Binding SyncWorkspace.Result.HasLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="実行ログを保存しました: " />
                    <Hyperlink Command="{Binding SyncWorkspace.OpenResultLogCommand}"
                               ToolTip="同期結果CSVを既定のアプリで開く">
                        <Run Text="同期結果CSVを開く" />
                    </Hyperlink>
                </TextBlock>

                <!-- 失敗した操作だけを一覧化し、原因(Error)と次に行うことを併記する。
                     差分DataGridの「エラーのみ表示」と同様、成功分を除いた「絞り込み済み」の一覧として見せる。 -->
                <Border Margin="22,8,0,0" Padding="8" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding SyncWorkspace.Result.HasFailedResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="失敗した操作" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <ScrollViewer MaxHeight="120" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SyncWorkspace.Result.FailedResults}"
                                          AutomationProperties.Name="失敗した操作の一覧">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <ui:Badge Content="{Binding KindLabel}" Appearance="Danger"
                                                      Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Email}" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                                                           ToolTip="{Binding Error}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding SyncWorkspace.Result.HiddenFailedResultsText}"
                                   Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding SyncWorkspace.Result.HasHiddenFailedResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="次に行うこと: 「差分を確認」で最新の状態を取得し、内容を確認してから再実行してください。"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <ui:Button Content="失敗・未実行分を再確認"
                           Command="{Binding SyncWorkspace.RetryRemainingCommand}"
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                           HorizontalAlignment="Left" Margin="22,8,0,0"
                           Visibility="{Binding SyncWorkspace.CanRetryResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.Name="最新状態から失敗または未実行分を再確認" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
