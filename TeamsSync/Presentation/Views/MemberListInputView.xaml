<UserControl x:Class="TeamsSync.Presentation.Views.MemberListInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TeamsSync.Presentation.ViewModels"
             xmlns:views="clr-namespace:TeamsSync.Presentation.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SectionLabelColumnWidth}" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
            <views:StepHeaderView IconSymbol="DocumentSearch24" HeaderText="2  メンバーリスト"
                                   SubtitleText="同期する一般メンバーの一覧を指定します" />
            <!-- チーム選択済みでまだメンバーリスト未指定のときだけ、この場所に表示する -->
            <views:StepIncompleteWarningView Margin="0,4,0,0"
                StepState="{Binding DataContext.WorkflowSteps.Step2State, RelativeSource={RelativeSource AncestorType=Window}}"
                Message="ファイルまたはテキストを指定してください" />
        </StackPanel>
        <!-- 入力確定済みで編集中でないときは、フルのタブUIの代わりにこの1行要約を表示する。
             「変更」で元のタブUIへ戻せる(EditInputCommand)。次に入力が確定すると再び折りたたむ -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0"
                    Visibility="{Binding ShowCollapsedSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,2,8,0"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
            <ui:Button Content="変更" Command="{Binding EditInputCommand}"
                       Appearance="Transparent" Margin="12,0,0,0" Padding="8,2"
                       ToolTip="ファイル選択またはテキスト貼り付けの入力へ戻ります"
                       AutomationProperties.Name="メンバーリストの入力を変更" />
        </StackPanel>
        <TabControl Grid.Column="1" AutomationProperties.Name="メンバー入力方法"
                    Visibility="{Binding ShowFullInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                    SelectedIndex="{Binding SelectedInputIndex}">
            <TabItem Header="ファイル">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Import.IsImportingMembers}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <Grid MinHeight="140" Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <ui:TextBox Text="{Binding FileLoad.Path}" IsReadOnly="True"
                                    ClearButtonEnabled="False"
                                    IsTabStop="False" AutomationProperties.Name="選択したメンバーリストのパス" />
                        <TextBlock Text="CSV または Excel（.xlsx）ファイルを選択できます" Margin="4,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="「メールアドレス」「氏名」等の列名を自動検出します（見つからない場合は1列目を使用）"
                                   Margin="4,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Margin="4,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="例）1行目「メールアドレス」、2行目以降" /><LineBreak />
                            <Run Text="taro.yamada@example.com のように入力します" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,6,0" IsIndeterminate="True"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding FileLoad.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.Name="ファイルを読み込み中" />
                            <TextBlock Text="{Binding FileLoad.InfoText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                        <ui:Button x:Name="BrowseButton" Content="_ファイルを選択"
                                   Command="{Binding BrowseCommand}"
                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Appearance="Secondary" ToolTip="ファイルを選択"
                                   AutomationProperties.Name="メンバーリストファイルを選択" />
                        <ui:Button Content="キャンセル" Command="{Binding CancelLoadCommand}"
                                   Margin="0,8,0,0" Appearance="Secondary"
                                   ToolTip="ファイル読込をキャンセル"
                                   Visibility="{Binding FileLoad.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.Name="ファイル読込をキャンセル" />
                        <ui:Button Content="テキストとして編集" Command="{Binding CopyFileContentToTextCommand}"
                                   Margin="0,8,0,0" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Symbol=Edit24}"
                                   ToolTip="読取結果をテキストへコピーして編集します（元ファイルは変更しません）"
                                   AutomationProperties.Name="ファイルの読取結果をテキストとして編集" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="テキスト貼り付け">
                <Grid MinHeight="140" Margin="8,4" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBox x:Name="PasteTextBox" Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" MaxHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                AutomationProperties.Name="1行1ユーザーの貼り付け入力" />
                    <Grid Grid.Row="1" Margin="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PasteInput.InfoText}" FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Style="{StaticResource PasteInputInfoTextStyle}" />
                        <!-- 狭いウィンドウ幅でも右端がクリップされないよう、固定幅Autoの水平StackPanelではなく
                             折り返し可能なWrapPanelにする。列もAutoから*へ変更し、実際に折り返せる有限幅を与える -->
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <ui:ProgressRing Width="16" Height="16" Margin="8,0" IsIndeterminate="True"
                                             Visibility="{Binding Import.IsFetchingMembers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.Name="現在のチームメンバーを取得中" />
                            <ui:Button Content="現在のメンバーを取り込む" Command="{Binding Import.ImportCurrentMembersCommand}"
                                       Icon="{ui:SymbolIcon Symbol=PeopleTeam24}" Appearance="Secondary"
                                       Margin="0,4"
                                       ToolTip="選択中チームの一般メンバーをテキスト入力へ取り込みます"
                                       AutomationProperties.Name="現在の一般メンバーを入力リストへ取り込む" />
                            <ui:Button Content="キャンセル" Command="{Binding Import.CancelImportCurrentMembersCommand}"
                                       Margin="8,4,0,4" Appearance="Secondary"
                                       Visibility="{Binding Import.IsImportingMembers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="現在のメンバーの取り込みをキャンセル" />
                            <ui:ProgressRing Width="16" Height="16" Margin="8,0" IsIndeterminate="True"
                                             Visibility="{Binding Export.IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.Name="メンバー一覧を出力中" />
                            <ui:Button Content="CSVへ出力" Command="{Binding Export.ExportCommand}"
                                       Icon="{ui:SymbolIcon Symbol=ArrowExportUp24}" Appearance="Secondary"
                                       Margin="8,4,0,4"
                                       ToolTip="選択中チームの現在の全メンバー(所有者を含む)をCSVファイルへ出力します"
                                       AutomationProperties.Name="選択中チームのメンバー一覧をCSVへ出力" />
                            <ui:ProgressRing Width="16" Height="16" Margin="8,0" IsIndeterminate="True"
                                             Visibility="{Binding PasteInput.IsParsing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.Name="貼り付け入力を解析中" />
                            <ui:Button Content="解析をキャンセル" Command="{Binding CancelParsingCommand}"
                                       Margin="8,4,0,4" Appearance="Secondary"
                                       Visibility="{Binding PasteInput.IsParsing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="貼り付け入力の解析をキャンセル" />
                            <ui:Button Content="入力を_反映" Command="{Binding ApplyPastedTextInputCommand}"
                                       Margin="8,4,0,4"
                                       Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                                       AutomationProperties.Name="貼り付け入力を反映">
                                <!-- 貼り付けテキストが変更されて未反映のときは、次にすべき操作として強調する。
                                     配色自体はApplicationResources.xamlのui:Button既定スタイル(Appearance=Primaryトリガー)に
                                     任せ、ここではAppearanceを切り替える条件だけを追加する -->
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnappliedPastedText}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>