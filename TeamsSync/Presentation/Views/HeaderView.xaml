<UserControl x:Class="TeamsSync.Presentation.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="20" Margin="0,0,12,0" />
                <TextBlock Text="TeamsSync" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="リストとチームの一般メンバーを安全に同期します" Margin="32,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ui:Button Grid.Row="0" Grid.Column="1" Command="{Binding Manual.OpenManualCommand}"
                   Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" Margin="0,0,12,0"
                   VerticalAlignment="Center" Appearance="Transparent" ToolTip="マニュアルを開く"
                   AutomationProperties.Name="マニュアルを開く" />
        <Grid Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
            <ui:Button x:Name="SignInButton" Content="_サインイン" Command="{Binding SignIn.SignInCommand}"
                       Appearance="Secondary" ToolTip="Microsoft 365にサインイン"
                       AutomationProperties.Name="Microsoft 365へサインイン"
                       BorderThickness="1" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowEnter20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </ui:Button.Icon>
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SignIn.IsSignedIn}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
            <ui:DropDownButton Content="{Binding SignIn.AccountText}" Icon="{ui:SymbolIcon Symbol=PersonAccounts24}"
                               AutomationProperties.Name="サインイン中のアカウント">
                <ui:DropDownButton.Style>
                    <Style TargetType="ui:DropDownButton" BasedOn="{StaticResource {x:Type ui:DropDownButton}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SignIn.IsSignedIn}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:DropDownButton.Style>
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="接続診断" Icon="{ui:SymbolIcon Symbol=Pulse24}"
                                  Command="{Binding PlacementTarget.DataContext.SignIn.RunDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="サインアウト" Icon="{ui:SymbolIcon Symbol=SignOut20}"
                                  Command="{Binding PlacementTarget.DataContext.SignIn.SignOutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </Grid>
        <!-- サインインが必要な理由をボタンの真下に表示する。全カードへ同じ案内を重複表示すると
             くどくなるため、常にここ1箇所だけに出す。
             このテキストは常時表示される静的な状態表示であり、動的な読み上げ通知は
             SyncActionBarViewのStatusText(初期値「サインインしてください」、こちらもLiveSetting="Polite")
             側に一本化する。両方にLiveSettingを付けると、サインアウト時などに意味の重複する
             ライブリージョンが同時に読み上げられてしまうため、ここでは付けない。 -->
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,4,0,0"
                    Visibility="{Binding SignIn.IsNotSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock Text="サインインが必要です" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
