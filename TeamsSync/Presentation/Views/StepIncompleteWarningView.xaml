<UserControl x:Class="TeamsSync.Presentation.Views.StepIncompleteWarningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TeamsSync.Presentation.ViewModels"
             x:Name="Root">
    <!-- 各手順カードが「現在の操作」の間だけ、実際にブロックしているコントロールの直近に表示する
         赤いエラーメッセージの共通レイアウト。StepStateへ手順ごとのWorkflowStepState、Messageへ
         案内文を呼び出し元から渡す -->
    <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StepState, ElementName=Root}"
                                 Value="{x:Static vm:WorkflowStepState.Current}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock Text="{Binding Message, ElementName=Root}" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
