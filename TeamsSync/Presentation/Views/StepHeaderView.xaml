<UserControl x:Class="TeamsSync.Presentation.Views.StepHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <!-- 「番号 見出し」+サブタイトルの2行見出しは、複数の手順カードで同じレイアウトが必要になったため、
         個々のカードXAMLへ複製せずこのUserControlへ切り出している -->
    <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="{Binding IconSymbol, ElementName=Root}" FontSize="16" Margin="0,0,6,0"
                           VerticalAlignment="Center" AutomationProperties.Name="" />
            <TextBlock Text="{Binding HeaderText, ElementName=Root}" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding SubtitleText, ElementName=Root}" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
