<UserControl x:Class="TeamsSync.Presentation.Views.TeamSelectionCardContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TeamsSync.Presentation.ViewModels"
             xmlns:views="clr-namespace:TeamsSync.Presentation.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TeamSelectionViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SectionLabelColumnWidth}" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <views:StepHeaderView Grid.Row="0" IconSymbol="PeopleTeam24" HeaderText="1  所有しているチーム"
                               SubtitleText="同期先のTeamsチームを選択します（オーナー権限のチームのみ表示）" />
        <ComboBox x:Name="TeamComboBox" Grid.Row="0" Grid.Column="1" Height="36"
                  IsEnabled="{Binding IsSelectionEnabled}"
                  IsEditable="True" StaysOpenOnEdit="True"
                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding TeamsView}"
                  SelectedItem="{Binding SelectedTeam}"
                  DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"
                  AutomationProperties.Name="同期対象チームの検索と選択" />
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
            <ui:Button Command="{Binding ClearSearchCommand}"
                       Icon="{ui:SymbolIcon Symbol=Dismiss16}"
                       Padding="8" Margin="0,0,8,0"
                       Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Appearance="Transparent" ToolTip="検索をクリア"
                       AutomationProperties.Name="チーム検索をクリア" />
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="チームを読み込み中" />
            <ui:Button Command="{Binding RefreshCommand}"
                       Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                       Padding="8" Appearance="Secondary" ToolTip="所有しているチームを再読み込み"
                       AutomationProperties.Name="所有チームを再読み込み" />
        </StackPanel>
        <!-- インデントはハードコード値ではなく、見出し列(SectionLabelColumnWidth)と同じGrid.Column="1"に
             配置することで、見出しの実際の幅に自動で揃える -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="14" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="該当するチームが見つかりません" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <!-- サインイン済みでまだチーム未選択のときだけ、この場所に表示する。上部の一括バナーで
             全カードに同じ案内を重複表示していたのをやめ、今ブロックしている箇所1つだけに絞った -->
        <views:StepIncompleteWarningView Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
            StepState="{Binding DataContext.WorkflowSteps.Step1State, RelativeSource={RelativeSource AncestorType=Window}}"
            Message="チームを選択してください" />
    </Grid>
</UserControl>