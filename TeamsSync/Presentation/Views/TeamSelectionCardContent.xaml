<UserControl x:Class="TeamsSync.Presentation.Views.TeamSelectionCardContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TeamsSync.Presentation.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SectionLabelColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="16" Margin="0,0,6,0"
                                   VerticalAlignment="Center" AutomationProperties.Name="" />
                    <TextBlock Text="1  所有しているチーム" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="同期先のTeamsチームを選択します（オーナー権限のチームのみ表示）" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="TeamComboBox" Grid.Column="1" Height="36"
                      IsEnabled="{Binding IsSelectionEnabled}"
                      IsEditable="True" StaysOpenOnEdit="True"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding TeamsView}"
                      SelectedItem="{Binding SelectedTeam}"
                      DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"
                      AutomationProperties.Name="同期対象チームの検索と選択" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <ui:Button Command="{Binding ClearSearchCommand}"
                           Icon="{ui:SymbolIcon Symbol=Dismiss16}"
                           Padding="8" Margin="0,0,8,0"
                           Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Appearance="Transparent" ToolTip="検索をクリア"
                           AutomationProperties.Name="チーム検索をクリア" />
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="チームを読み込み中" />
                <ui:Button Content="_再読込" Command="{Binding RefreshCommand}"
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                           Appearance="Secondary" ToolTip="所有しているチームを再読み込み"
                           AutomationProperties.Name="所有チームを再読み込み" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="192,8,0,0"
                    Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="14" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="該当するチームが見つかりません" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <!-- サインイン済みでまだチーム未選択のときだけ、この場所に表示する。上部の一括バナーで
             全カードに同じ案内を重複表示していたのをやめ、今ブロックしている箇所1つだけに絞った。 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="192,4,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.WorkflowSteps.Step1State, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Static vm:WorkflowStepState.Current}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock Text="チームを選択してください" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
