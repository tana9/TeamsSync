<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Version>0.0.1</Version>
    <Product>TeamsSync</Product>
    <Description>Microsoft Graph APIを使い、CSVまたはExcelの一覧とMicrosoft Teamsの一般メンバーを同期するWPFデスクトップアプリ</Description>
    <AssemblyTitle>$(Description)</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    <PackageReference Include="CsvHelper" Version="33.1.0"/>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10"/>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10"/>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0"/>
    <PackageReference Include="Microsoft.Graph" Version="6.2.0"/>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0"/>
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageReference Include="WPF-UI" Version="4.3.0"/>
  </ItemGroup>
  <ItemGroup>
    <None Remove="appsettings.json"/>
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json"/>
    <None Remove="Resources\Manual.html"/>
    <EmbeddedResource Include="Resources\Manual.html" LogicalName="Manual.html"/>
    <None Remove="Resources\Authentication\*.html"/>
    <EmbeddedResource Include="Resources\Authentication\SignInSuccess.html" LogicalName="Authentication.SignInSuccess.html"/>
    <EmbeddedResource Include="Resources\Authentication\SignInError.html" LogicalName="Authentication.SignInError.html"/>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico"/>
  </ItemGroup>
  <ItemGroup>
    <None Include="docs\MANUAL.md"/>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TeamsSync.Tests"/>
  </ItemGroup>
</Project>
