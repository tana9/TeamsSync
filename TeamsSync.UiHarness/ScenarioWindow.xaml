<ui:FluentWindow x:Class="TeamsSync.UiHarness.ScenarioWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="UI Harness シナリオ" Width="390" Height="290"
                 WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" Topmost="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="表示ケース" FontSize="16" FontWeight="SemiBold" />
        <ComboBox x:Name="ScenarioPicker" Grid.Row="1" Margin="0,10,0,0"
                  ItemsSource="{Binding Scenarios}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedScenario}" />
        <Border Grid.Row="2" Margin="0,12,0,12" Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                BorderThickness="1" CornerRadius="6">
            <TextBlock Text="{Binding SelectedScenario.Description}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="適用" Width="100" IsDefault="True" Click="ApplyScenario">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#0F6CBD" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="#0F6CBD" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E1E1E1" />
                                <Setter Property="Foreground" Value="#606060" />
                                <Setter Property="BorderBrush" Value="#B8B8B8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ui:Button Content="閉じる" Width="80" Margin="8,0,0,0" Appearance="Secondary" Click="CloseWindow" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>